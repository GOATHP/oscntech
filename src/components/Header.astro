---
import { u, currentPath } from '../lib/url';
import { nav } from '../data/nav';
import site from '../data/site.json';

interface Props { transparent?: boolean }
const { transparent = false } = Astro.props;
const path = currentPath(Astro.url.pathname);
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class:list={['header', { transparent }]} data-transparent={transparent ? 'true' : undefined}>
  <div class="bar">
    <div class="container inner">
      <a href={u('/')} class="logo">
        <img src={u('/images/logo.png')} alt={site.name} />
      </a>
      <nav class="nav" aria-label="주 메뉴">
        <ul>
          {nav.map((item) => (
            <li class:list={['nav-item', { active: isActive(item.href) || item.children?.some((c) => isActive(c.href)) }]}>
              <a href={u(item.href)}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <button class="menu-toggle" aria-label="메뉴 열기" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- 메뉴에 마우스를 올리면 펼쳐지는 전체 메뉴 -->
  <div class="mega">
    <div class="container mega-inner">
      <div class="mega-spacer"></div>
      <div class="mega-cols">
        {nav.map((item) => (
          <ul class="mega-col">
            {(item.children ?? [{ label: item.label, href: item.href }]).map((c) => (
              <li><a href={u(c.href)}>{c.label}</a></li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </div>

  <!-- 모바일 전체 메뉴 -->
  <div class="mobile-menu">
    <ul>
      {nav.map((item) => (
        <li>
          <a class="m-top" href={u(item.href)}>{item.label}</a>
          {item.children && (
            <ul>{item.children.map((c) => <li><a href={u(c.href)}>{c.label}</a></li>)}</ul>
          )}
        </li>
      ))}
    </ul>
  </div>
</header>

<style>
  .header { position: sticky; top: 0; left: 0; right: 0; z-index: 100; color: var(--text); }
  .header.transparent { position: fixed; }
  .bar { background: #fff; border-bottom: 1px solid var(--line); transition: background .3s, border-color .3s; }
  .inner { display: flex; align-items: center; justify-content: space-between; height: 80px; }
  .logo { display: flex; align-items: center; }
  .logo img { height: 46px; width: auto; }

  .nav { flex: 1; display: flex; justify-content: flex-end; }
  .nav > ul { display: grid; grid-template-columns: repeat(5, 150px); list-style: none; margin: 0; padding: 0; }
  .nav-item > a { display: block; text-align: center; line-height: 80px; font-weight: 700; font-size: 1.05rem; transition: color .2s; }
  .nav-item.active > a, .nav-item > a:hover { color: var(--accent); }

  /* 투명 헤더 (메인 화면 맨 위) */
  .header.transparent:not(.solid):not(.open-mega) .bar { background: transparent; border-color: rgba(255,255,255,.2); }
  .header.transparent:not(.solid):not(.open-mega) .nav-item > a { color: #fff; }
  .header.transparent:not(.solid):not(.open-mega) .menu-toggle span { background: #fff; }

  /* 전체 메뉴 */
  .mega { position: absolute; left: 0; right: 0; top: 80px; background: #fff; border-bottom: 1px solid var(--line);
    box-shadow: 0 16px 32px rgba(0,0,0,.08); max-height: 0; overflow: hidden; transition: max-height .35s ease; }
  .header.open-mega .mega { max-height: 400px; }
  .mega-inner { display: flex; justify-content: space-between; }
  .mega-cols { display: grid; grid-template-columns: repeat(5, 150px); padding: 24px 0 32px; }
  .mega-col { list-style: none; margin: 0; padding: 0 8px; text-align: center; border-left: 1px solid var(--line); }
  .mega-col:first-child { border-left: 0; }
  .mega-col a { display: block; padding: 7px 0; color: var(--muted); font-size: .95rem; }
  .mega-col a:hover { color: var(--accent); }

  .menu-toggle { display: none; width: 40px; height: 40px; background: none; border: 0; cursor: pointer; padding: 8px; }
  .menu-toggle span { display: block; height: 2px; background: var(--text); margin: 6px 0; transition: transform .3s, opacity .3s; }
  .header.open-mobile .menu-toggle span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
  .header.open-mobile .menu-toggle span:nth-child(2) { opacity: 0; }
  .header.open-mobile .menu-toggle span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

  .mobile-menu { display: none; }

  @media (max-width: 1100px) {
    .nav > ul, .mega-cols { grid-template-columns: repeat(5, 120px); }
  }
  @media (max-width: 900px) {
    .inner { height: 64px; }
    .logo img { height: 36px; }
    .nav, .mega { display: none; }
    .menu-toggle { display: block; }
    .mobile-menu { position: fixed; top: 64px; left: 0; right: 0; bottom: 0; background: #fff; overflow-y: auto; padding: 8px 20px 40px; }
    .header.open-mobile .mobile-menu { display: block; }
    .header.open-mobile .bar { background: #fff !important; }
    .header.open-mobile .menu-toggle span { background: var(--text) !important; }
    .mobile-menu > ul { list-style: none; margin: 0; padding: 0; }
    .mobile-menu > ul > li { border-bottom: 1px solid var(--line); padding: 8px 0; }
    .m-top { display: block; padding: 10px 0; font-weight: 700; font-size: 1.1rem; }
    .mobile-menu ul ul { list-style: none; padding: 0 0 8px 12px; margin: 0; }
    .mobile-menu ul ul a { display: block; padding: 6px 0; color: var(--muted); }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.header');
  if (header) {
    // 스크롤하면 흰 헤더로
    if (header.dataset.transparent) {
      const onScroll = () => header.classList.toggle('solid', window.scrollY > 40);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }
    // 전체 메뉴 열고 닫기 (데스크톱)
    const nav = header.querySelector('.nav');
    const mega = header.querySelector('.mega');
    let timer: number | undefined;
    const open = () => { clearTimeout(timer); header.classList.add('open-mega'); };
    const close = () => { timer = window.setTimeout(() => header.classList.remove('open-mega'), 120); };
    nav?.addEventListener('mouseenter', open);
    nav?.addEventListener('mouseleave', close);
    mega?.addEventListener('mouseenter', open);
    mega?.addEventListener('mouseleave', close);
    nav?.addEventListener('focusin', open);
    // 모바일 메뉴
    const btn = header.querySelector('.menu-toggle');
    btn?.addEventListener('click', () => {
      const isOpen = header.classList.toggle('open-mobile');
      btn.setAttribute('aria-expanded', String(isOpen));
      document.body.style.overflow = isOpen ? 'hidden' : '';
    });
  }
</script>
