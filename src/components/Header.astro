---
import { nav } from '../data/nav';
import site from '../data/site.json';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="header">
  <div class="container inner">
    <a href="/" class="logo">
      <!-- 로고 이미지가 생기면 public/images/logo.png 에 넣고 아래 줄 주석을 풀어 주세요 -->
      <!-- <img src="/images/logo.png" alt={site.name} height="36" /> -->
      <span>{site.name}</span>
    </a>
    <button class="menu-toggle" aria-label="메뉴 열기" aria-expanded="false">☰</button>
    <nav class="nav">
      <ul>
        {nav.map((item) => (
          <li class:list={['nav-item', { active: isActive(item.href) || item.children?.some((c) => isActive(c.href)) }]}>
            <a href={item.href}>{item.label}</a>
            {item.children && (
              <ul class="sub">
                {item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header { position: sticky; top: 0; z-index: 50; background: #fff; border-bottom: 1px solid var(--line); }
  .inner { display: flex; align-items: center; justify-content: space-between; height: 72px; }
  .logo { font-size: 1.4rem; font-weight: 800; color: var(--brand); letter-spacing: -.02em; }
  .nav > ul { display: flex; gap: 8px; list-style: none; margin: 0; padding: 0; }
  .nav-item { position: relative; }
  .nav-item > a { display: block; padding: 24px 16px; font-weight: 600; }
  .nav-item.active > a, .nav-item > a:hover { color: var(--brand); }
  .sub { display: none; position: absolute; top: 100%; left: 0; min-width: 180px; background: #fff; border: 1px solid var(--line); border-radius: 8px; list-style: none; margin: 0; padding: 8px 0; box-shadow: 0 8px 24px rgba(0,0,0,.08); }
  .sub a { display: block; padding: 8px 18px; font-size: .95rem; }
  .sub a:hover { background: var(--bg-soft); color: var(--brand); }
  .nav-item:hover .sub, .nav-item:focus-within .sub { display: block; }
  .menu-toggle { display: none; background: none; border: 0; font-size: 1.6rem; cursor: pointer; }
  @media (max-width: 860px) {
    .menu-toggle { display: block; }
    .nav { display: none; position: absolute; top: 72px; left: 0; right: 0; background: #fff; border-bottom: 1px solid var(--line); max-height: calc(100vh - 72px); overflow-y: auto; }
    .nav.open { display: block; }
    .nav > ul { flex-direction: column; gap: 0; padding: 8px 20px 20px; }
    .nav-item > a { padding: 12px 0; }
    .sub { display: block; position: static; border: 0; box-shadow: none; padding: 0 0 8px 12px; }
  }
</style>

<script>
  const btn = document.querySelector('.menu-toggle');
  const nav = document.querySelector('.nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(!!open));
  });
</script>
