---
import admin from '../../data/admin.json';
import site from '../../data/site.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{site.name} 관리자</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />
</head>
<body data-api={admin.apiUrl} data-base={base}>
  <header class="top">
    <strong>{site.name} 관리자</strong>
    <div class="top-right">
      <a href={base + '/'} target="_blank" rel="noopener">사이트 보기 ↗</a>
      <button id="logout" class="ghost" hidden>로그아웃</button>
    </div>
  </header>

  <section id="login" class="login" hidden>
    <h1>관리자 로그인</h1>
    <form id="login-form">
      <input id="password" type="password" placeholder="비밀번호" autocomplete="current-password" required />
      <button type="submit">들어가기</button>
    </form>
    <p id="login-msg" class="msg"></p>
  </section>

  <section id="setup" class="login" hidden>
    <h1>아직 저장 서버가 연결되지 않았어요</h1>
    <p>src/data/admin.json 의 apiUrl 에 Cloudflare Worker 주소를 넣어 주세요.</p>
  </section>

  <main id="app" hidden>
    <nav id="tabs" class="tabs"></nav>
    <div id="editor" class="editor"></div>
    <div class="savebar">
      <span id="status" class="msg"></span>
      <button id="save">저장하기</button>
    </div>
  </main>

  <script is:inline src={base + '/admin/admin.js'}></script>
</body>
</html>

<style is:global>
  :root { --brand: #d0101e; --line: #dde3ea; --soft: #f5f7fa; --muted: #5f6b7a; --danger: #c0392b; }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: 'Pretendard', -apple-system, 'Apple SD Gothic Neo', sans-serif; color: #1f2933; background: var(--soft); }
  button { font: inherit; cursor: pointer; border: 0; border-radius: 6px; padding: 10px 18px; background: var(--brand); color: #fff; font-weight: 600; }
  button.ghost { background: transparent; color: var(--brand); border: 1px solid var(--line); }
  button.small { padding: 6px 12px; font-size: .85rem; white-space: nowrap; }
  button.danger { background: transparent; color: var(--danger); border: 1px solid #f0c9c4; }
  button:disabled { opacity: .5; cursor: default; }
  .top { display: flex; justify-content: space-between; align-items: center; padding: 14px 20px; background: #fff; border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 5; }
  .top-right { display: flex; gap: 14px; align-items: center; }
  .top a { color: var(--brand); text-decoration: none; font-size: .95rem; }
  .login { max-width: 360px; margin: 12vh auto; background: #fff; padding: 32px; border-radius: 12px; border: 1px solid var(--line); }
  .login h1 { font-size: 1.3rem; margin: 0 0 20px; }
  .login form { display: grid; gap: 10px; }
  input, textarea { font: inherit; width: 100%; padding: 10px 12px; border: 1px solid var(--line); border-radius: 6px; background: #fff; }
  textarea { min-height: 90px; resize: vertical; }
  .msg { color: var(--muted); font-size: .92rem; }
  .msg.error { color: var(--danger); }
  .msg.ok { color: #1e7d3a; }
  main { max-width: 900px; margin: 0 auto; padding: 20px 20px 100px; }
  .tabs { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 16px; }
  .tabs button { background: #fff; color: #1f2933; border: 1px solid var(--line); }
  .tabs button.active { background: var(--brand); color: #fff; border-color: var(--brand); }
  .editor { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 24px; }
  .field { margin-bottom: 18px; }
  .field > label { display: block; font-weight: 600; margin-bottom: 6px; font-size: .95rem; }
  .hint { color: var(--muted); font-size: .82rem; margin-top: 4px; }
  .group { border: 1px solid var(--line); border-radius: 10px; padding: 16px; margin-bottom: 18px; }
  .group > h3 { margin: 0 0 14px; font-size: 1.05rem; }
  .item { border: 1px solid var(--line); border-radius: 8px; padding: 14px; margin-bottom: 10px; background: var(--soft); }
  .item-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 10px; font-weight: 600; }
  .item-actions { display: flex; gap: 6px; }
  .row { display: flex; gap: 8px; align-items: center; margin-bottom: 8px; }
  .img { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
  video.preview { object-fit: cover; background: #000; }
  .img .preview { width: 120px; height: 90px; border-radius: 6px; background: #e6ebf1 center / cover no-repeat; display: grid; place-items: center; color: var(--muted); font-size: .8rem; }
  .savebar { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-top: 1px solid var(--line); padding: 12px 20px; display: flex; justify-content: flex-end; align-items: center; gap: 14px; }
</style>
