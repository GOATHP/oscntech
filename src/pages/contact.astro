---
import { u } from '../lib/url';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import site from '../data/site.json';

// 문의는 FormSubmit(무료, 가입 없음)을 통해 회사 메일로 바로 전달돼요.
// 처음 한 번은 회사 메일로 온 'Activate Form' 메일의 버튼을 눌러야 해요.
// 전송이 안 되면 방문자의 메일 앱을 열어서 보내게 해요.
const FORM_ENDPOINT = `https://formsubmit.co/ajax/${site.email}`;
---
<Layout title="문의하기">
  <PageHero eyebrow="Contact" title="문의하기" desc="설비 견적과 상담 문의를 남겨 주시면 빠르게 연락드리겠습니다." />
  <section class="section">
    <div class="container contact">
      <form class="form" id="contact-form" data-endpoint={FORM_ENDPOINT} data-email={site.email}>
        <input type="text" name="_honey" tabindex="-1" autocomplete="off" style="display:none" />
        <div class="row">
          <label>회사명<input name="company" required /></label>
          <label>담당자<input name="name" required /></label>
        </div>
        <div class="row">
          <label>연락처<input name="phone" type="tel" required /></label>
          <label>이메일<input name="email" type="email" required /></label>
        </div>
        <label>문의 내용<textarea name="message" rows="7" required></textarea></label>
        <label class="agree"><input type="checkbox" required /> 개인정보 수집 및 이용에 동의합니다. <a href={u('/privacy')}>내용 보기</a></label>
        <button class="btn" type="submit">보내기</button>
        <p class="form-msg" role="status"></p>
      </form>
      <aside class="side card">
        <div class="card-body">
          <h3>연락처</h3>
          <p><strong>TEL</strong> <a href={`tel:${site.tel}`}>{site.tel}</a></p>
          <p><strong>EMAIL</strong> <a href={`mailto:${site.email}`}>{site.email}</a></p>
          <p><strong>상담시간</strong> {site.hours}</p>
          <hr />
          <p><strong>본사</strong> {site.head}</p>
          <p><strong>공장</strong> {site.factory}</p>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .contact { display: grid; grid-template-columns: 1.6fr 1fr; gap: 40px; align-items: start; }
  .form { display: grid; gap: 18px; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  label { display: grid; gap: 6px; font-weight: 600; font-size: .95rem; }
  input, textarea { font: inherit; padding: 12px 14px; border: 1px solid var(--line); border-radius: 6px; font-weight: 400; }
  input:focus, textarea:focus { outline: 2px solid var(--accent); border-color: transparent; }
  .agree { display: flex; align-items: center; gap: 8px; font-weight: 400; color: var(--muted); }
  .agree a { text-decoration: underline; }
  .form .btn { justify-self: start; padding: 14px 40px; }
  .side p { margin: 0 0 8px; color: var(--text); }
  .side hr { border: 0; border-top: 1px solid var(--line); margin: 16px 0; }
  .form-msg { margin: 0; min-height: 1.4em; color: var(--muted); }
  .form-msg.ok { color: #1a7f37; font-weight: 600; }
  .form-msg.error { color: var(--accent); }
  @media (max-width: 860px) { .contact, .row { grid-template-columns: 1fr; } }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  if (form) {
    const msg = form.querySelector<HTMLElement>('.form-msg')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const labels: Record<string, string> = { company: '회사명', name: '담당자', phone: '연락처', email: '이메일', message: '문의 내용' };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      if (fd.get('_honey')) return;
      const data: Record<string, string> = {};
      for (const k of Object.keys(labels)) data[labels[k]] = String(fd.get(k) ?? '').trim();
      const subject = `[홈페이지 문의] ${data['회사명']} ${data['담당자']}`;
      const mailto = () => {
        const body = Object.entries(data).map(([k, v]) => `${k}: ${v}`).join('\n');
        location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      };
      btn.disabled = true; msg.className = 'form-msg'; msg.textContent = '보내는 중...';
      try {
        const res = await fetch(form.dataset.endpoint!, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ ...data, _subject: subject, _replyto: data['이메일'], _template: 'table', _captcha: 'false' }),
        });
        const json = await res.json().catch(() => ({}));
        if (res.ok && String(json.success) === 'true') {
          form.reset();
          msg.className = 'form-msg ok'; msg.textContent = '문의가 접수되었습니다. 빠르게 연락드리겠습니다.';
        } else throw new Error(json.message || 'fail');
      } catch {
        msg.className = 'form-msg error'; msg.textContent = '바로 전송이 안 되어 메일 앱으로 보내기를 엽니다.';
        mailto();
      } finally { btn.disabled = false; }
    });
  }
</script>
