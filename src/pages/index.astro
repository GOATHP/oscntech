---
import { u } from '../lib/url';
import Layout from '../layouts/Layout.astro';
import ImageBox from '../components/ImageBox.astro';
import site from '../data/site.json';
import pages from '../data/pages.json';
import productsData from '../data/products.json';

const home = pages.home;
const slides = home.slides.length ? home.slides : [{ image: '', title: site.name, desc: '', linkLabel: '', link: '' }];
const areas = pages.business.areas;
const products = productsData.products;
const news = (pages.news?.items ?? []).slice(0, 4);
const seconds = Math.max(3, Number(home.slideSeconds) || 6);
const lines = (t: string) => (t || '').split('\n');
---
<Layout transparentHeader>
  <!-- 메인 배너 슬라이드 -->
  <section class="hero" data-seconds={seconds}>
    {slides.map((s, i) => (
      <div class:list={['slide', { active: i === 0 }]}>
        <div class="slide-bg" style={s.image ? `background-image: url('${u(s.image)}')` : undefined}>
          {s.video && (
            <video class="slide-video" src={u(s.video)} poster={s.image ? u(s.image) : undefined}
              muted loop playsinline preload={i === 0 ? 'auto' : 'metadata'} autoplay={i === 0}></video>
          )}
        </div>
        <div class="container slide-text">
          <div class="eyebrow">{site.name}</div>
          <h2 class="slide-title">{lines(s.title).map((l, j) => <>{j > 0 && <br />}{l}</>)}</h2>
          {s.desc && <p class="slide-desc">{s.desc}</p>}
          {s.link && <a class="more" href={u(s.link)}>{s.linkLabel || '자세히 보기'} <span>→</span></a>}
        </div>
      </div>
    ))}
    {slides.length > 1 && (
      <div class="container controls">
        <div class="counter"><b class="cur">01</b> / {String(slides.length).padStart(2, '0')}</div>
        <div class="progress"><i></i></div>
        <button class="prev" aria-label="이전 슬라이드">‹</button>
        <button class="pause" aria-label="일시정지">❚❚</button>
        <button class="next" aria-label="다음 슬라이드">›</button>
      </div>
    )}
    <div class="scroll-hint">SCROLL</div>
  </section>

  <!-- 회사 소개 문구 -->
  <section class="section intro">
    <div class="container">
      <div class="eyebrow" data-reveal>About {site.name}</div>
      <h2 class="intro-title" data-reveal data-reveal-delay="1">{home.introTitle}</h2>
      <p class="intro-text" data-reveal data-reveal-delay="2">{home.intro}</p>
      <a class="more dark" href={u('/about')} data-reveal data-reveal-delay="3">회사소개 보기 <span>→</span></a>
    </div>
  </section>

  <!-- 사업분야 -->
  <section class="section soft">
    <div class="container">
      <div class="head" data-reveal>
        <div>
          <div class="eyebrow">Business</div>
          <h2 class="section-title">{home.businessTitle}</h2>
          <p class="section-desc">{home.businessDesc}</p>
        </div>
        <a class="more dark" href={u('/business')}>전체 보기 <span>→</span></a>
      </div>
      <div class="biz-grid">
        {areas.map((a, i) => (
          <a class="biz" href={u('/business')} data-reveal data-reveal-delay={String(i % 4)}>
            <div class="biz-img" style={a.image ? `background-image: url('${u(a.image)}')` : undefined}></div>
            <div class="biz-body">
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{a.title}</h3>
              <p>{a.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 공급제품 -->
  <section class="section">
    <div class="container">
      <div class="head" data-reveal>
        <div>
          <div class="eyebrow">Product</div>
          <h2 class="section-title">공급제품</h2>
        </div>
        <a class="more dark" href={u('/products')}>전체 보기 <span>→</span></a>
      </div>
      <div class="grid cols-3">
        {products.map((p, i) => (
          <a class="card" href={u(`/products/${p.slug}`)} data-reveal data-reveal-delay={String(i % 3)}>
            <ImageBox src={p.image} alt={p.title} />
            <div class="card-body"><h3>{p.title}</h3><p>{p.summary}</p></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 소식 -->
  {news.length > 0 && (
    <section class="section soft">
      <div class="container">
        <div class="head" data-reveal>
          <div>
            <div class="eyebrow">News</div>
            <h2 class="section-title">{site.name} 소식</h2>
          </div>
          <a class="more dark" href={u('/news')}>소식 더보기 <span>→</span></a>
        </div>
        <ul class="news">
          {news.map((n, i) => (
            <li data-reveal data-reveal-delay={String(i % 4)}>
              <a href={u('/news') + '#n' + i}>
                <span class="date">{n.date}</span>
                <strong>{n.title}</strong>
                <span class="arrow">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- 상담 배너 -->
  <section class="cta" style={slides[0].image ? `background-image: url('${u(slides[0].image)}')` : undefined}>
    <div class="container" data-reveal>
      <h2>{home.ctaTitle}</h2>
      <p>{site.hours} · <a href={`tel:${site.tel}`}>{site.tel}</a></p>
      <a class="btn" href={u('/contact')}>{home.ctaButton}</a>
    </div>
  </section>
</Layout>

<style>
  /* 슬라이드 */
  .hero { position: relative; height: 100vh; min-height: 560px; overflow: hidden; background: var(--brand-dark); color: #fff; }
  .slide { position: absolute; inset: 0; opacity: 0; transition: opacity 1.2s ease; display: flex; align-items: center; }
  .slide.active { opacity: 1; z-index: 1; }
  .slide-bg { position: absolute; inset: 0; background: linear-gradient(120deg, var(--brand-dark), var(--brand)) center / cover no-repeat; }
  .slide-bg[style] { background-size: cover; background-position: center; }
  .slide-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .slide.active .slide-bg { animation: zoom 9s ease-out both; }
  @keyframes zoom { from { transform: scale(1.1); } to { transform: scale(1); } }
  .slide::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,.45), rgba(0,0,0,0) 65%); }
  .slide-text { position: relative; z-index: 2; width: 100%; }
  .slide-text > * { opacity: 0; transform: translateY(30px); transition: opacity .9s ease, transform .9s ease; }
  .slide.active .slide-text > * { opacity: 1; transform: none; }
  .slide.active .slide-text > :nth-child(2) { transition-delay: .15s; }
  .slide.active .slide-text > :nth-child(3) { transition-delay: .3s; }
  .slide.active .slide-text > :nth-child(4) { transition-delay: .45s; }
  .hero .eyebrow { color: rgba(255,255,255,.85); }
  .slide-title { font-size: clamp(2.2rem, 5vw, 4.2rem); line-height: 1.25; margin: 14px 0 20px; font-weight: 800; letter-spacing: -.02em; text-shadow: 0 2px 16px rgba(0,0,0,.35); }
  .slide-desc { font-size: 1.15rem; max-width: 640px; opacity: .92; margin: 0 0 32px; text-shadow: 0 1px 8px rgba(0,0,0,.4); }

  .more { display: inline-flex; align-items: center; gap: 10px; font-weight: 700; padding-bottom: 4px; border-bottom: 2px solid currentColor; }
  .more span { transition: transform .25s; }
  .more:hover span { transform: translateX(6px); }
  .more.dark { color: var(--text); }
  .more.dark:hover { color: var(--accent); }

  .controls { position: absolute; left: 0; right: 0; bottom: 56px; z-index: 3; display: flex; align-items: center; gap: 14px; }
  .counter { font-size: .95rem; letter-spacing: .05em; }
  .counter b { font-size: 1.1rem; }
  .progress { width: 160px; height: 2px; background: rgba(255,255,255,.3); position: relative; overflow: hidden; }
  .progress i { position: absolute; inset: 0; background: #fff; transform-origin: left; transform: scaleX(0); }
  .progress i.run { animation: bar linear forwards; }
  @keyframes bar { to { transform: scaleX(1); } }
  .controls button { width: 36px; height: 36px; border-radius: 50%; border: 1px solid rgba(255,255,255,.5); background: transparent; color: #fff; cursor: pointer; font-size: 1.1rem; line-height: 1; }
  .controls .pause { font-size: .6rem; letter-spacing: -1px; }
  .controls button:hover { background: rgba(255,255,255,.15); }
  .scroll-hint { position: absolute; right: 40px; bottom: 56px; z-index: 3; font-size: .75rem; letter-spacing: .3em; writing-mode: vertical-rl; opacity: .8; }
  .scroll-hint::after { content: ''; display: block; width: 1px; height: 48px; background: #fff; margin: 10px auto 0; animation: drop 1.8s infinite; }
  @keyframes drop { 0% { transform: scaleY(0); transform-origin: top; } 50% { transform: scaleY(1); transform-origin: top; } 51% { transform-origin: bottom; } 100% { transform: scaleY(0); transform-origin: bottom; } }

  /* 소개 */
  .intro { text-align: center; padding: 140px 0; }
  .intro-title { font-size: clamp(1.8rem, 3.5vw, 2.8rem); margin: 12px 0 24px; letter-spacing: -.02em; }
  .intro-text { white-space: pre-line; color: var(--muted); font-size: 1.15rem; max-width: 760px; margin: 0 auto 36px; }

  .head { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; margin-bottom: 40px; flex-wrap: wrap; }
  .head .section-desc { margin-bottom: 0; }

  /* 사업분야 */
  .biz-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; }
  .biz { position: relative; display: block; height: 380px; border-radius: 14px; overflow: hidden; color: #fff; background: var(--brand); }
  .biz-img { position: absolute; inset: 0; background: linear-gradient(160deg, var(--brand), var(--brand-dark)) center / cover; transition: transform .6s ease; }
  .biz-img[style] { background-size: cover; background-position: center; }
  .biz::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(0,0,0,.7), rgba(0,0,0,0) 60%); }
  .biz:hover .biz-img { transform: scale(1.06); }
  .biz-body { position: absolute; left: 0; right: 0; bottom: 0; z-index: 1; padding: 28px; }
  .biz .num { font-weight: 800; color: var(--accent); }
  .biz h3 { margin: 6px 0 8px; font-size: 1.35rem; }
  .biz p { margin: 0; opacity: .85; font-size: .95rem; max-height: 0; overflow: hidden; transition: max-height .4s ease; }
  .biz:hover p { max-height: 120px; }

  /* 소식 */
  .news { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--text); }
  .news a { display: flex; align-items: center; gap: 32px; padding: 26px 8px; border-bottom: 1px solid var(--line); background: #fff; transition: padding .25s, color .2s; }
  .news a:hover { padding-left: 20px; color: var(--accent); }
  .news .date { color: var(--muted); font-size: .92rem; min-width: 96px; }
  .news strong { flex: 1; font-size: 1.08rem; }
  .news .arrow { color: var(--muted); }

  /* 상담 배너 */
  .cta { position: relative; color: #fff; text-align: center; padding: 110px 0; background: var(--brand-dark) center / cover fixed; }
  .cta::before { content: ''; position: absolute; inset: 0; background: rgba(20,24,29,.72); }
  .cta .container { position: relative; }
  .cta h2 { font-size: clamp(1.6rem, 3vw, 2.4rem); margin: 0 0 12px; }
  .cta p { margin: 0 0 32px; opacity: .9; }
  .cta .btn { padding: 16px 44px; font-size: 1.05rem; }

  @media (max-width: 720px) {
    .hero { min-height: 520px; height: 88vh; }
    .controls { bottom: 32px; }
    .progress { width: 80px; }
    .scroll-hint { display: none; }
    .intro { padding: 90px 0; }
    .biz { height: 280px; }
    .biz p { max-height: none; }
    .news a { flex-wrap: wrap; gap: 6px 16px; }
    .news .arrow { display: none; }
    .cta { background-attachment: scroll; }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('.hero');
  const slides = hero ? Array.from(hero.querySelectorAll<HTMLElement>('.slide')) : [];
  if (hero && slides.length > 1) {
    const ms = Number(hero.dataset.seconds || 6) * 1000;
    const cur = hero.querySelector('.cur');
    const bar = hero.querySelector<HTMLElement>('.progress i');
    const pauseBtn = hero.querySelector<HTMLButtonElement>('.pause');
    let i = 0, timer: number | undefined, paused = false;
    const runBar = () => {
      if (!bar) return;
      bar.classList.remove('run'); void bar.offsetWidth;
      bar.style.animationDuration = ms + 'ms';
      if (!paused) bar.classList.add('run');
    };
    const go = (n: number) => {
      slides[i].classList.remove('active');
      slides[i].querySelector('video')?.pause();
      i = (n + slides.length) % slides.length;
      slides[i].classList.add('active');
      slides[i].querySelector('video')?.play().catch(() => {});
      if (cur) cur.textContent = String(i + 1).padStart(2, '0');
      restart();
    };
    const restart = () => { clearTimeout(timer); runBar(); if (!paused) timer = window.setTimeout(() => go(i + 1), ms); };
    hero.querySelector('.next')?.addEventListener('click', () => go(i + 1));
    hero.querySelector('.prev')?.addEventListener('click', () => go(i - 1));
    pauseBtn?.addEventListener('click', () => {
      paused = !paused;
      pauseBtn.textContent = paused ? '▶' : '❚❚';
      pauseBtn.setAttribute('aria-label', paused ? '재생' : '일시정지');
      restart();
    });
    // 휴대폰에서 좌우로 밀어서 넘기기
    let x0: number | null = null;
    hero.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    hero.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) go(dx < 0 ? i + 1 : i - 1);
      x0 = null;
    });
    restart();
  }
</script>
