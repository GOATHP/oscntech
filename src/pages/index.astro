---
import { u } from '../lib/url';
import Layout from '../layouts/Layout.astro';
import ImageBox from '../components/ImageBox.astro';
import site from '../data/site.json';
import pages from '../data/pages.json';
const home = pages.home;
const heroBg = u(home.heroImage || '/images/hero.jpg');
import productsData from '../data/products.json';
const products = productsData.products;
---
<Layout>
  <section class="hero" style={`--hero-bg: url('${heroBg}')`}>
    <div class="container">
      <div class="eyebrow">{site.name}</div>
      <h1>{home.heroTitle.split('\n').map((l, i) => <>{i > 0 && <br />}{l}</>)}</h1>
      <p>{site.tagline}</p>
      <div class="actions">
        <a class="btn" href={u('/products')}>제품 보기</a>
        <a class="btn outline" href={u('/contact')}>상담 문의</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="eyebrow">Introduce</div>
      <h2 class="section-title">회사소개</h2>
      <p class="section-desc">{home.intro}</p>
      <div class="grid cols-3">
        <a class="card" href={u('/about')}><div class="card-body"><h3>인사말</h3><p>대표 인사말과 경영 이념</p></div></a>
        <a class="card" href={u('/about/certifications')}><div class="card-body"><h3>인증현황</h3><p>보유 인증서와 특허</p></div></a>
        <a class="card" href={u('/about/location')}><div class="card-body"><h3>오시는 길</h3><p>본사와 공장 위치 안내</p></div></a>
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <div class="eyebrow">Product</div>
      <h2 class="section-title">공급제품</h2>
      <p class="section-desc">제품 분류를 누르면 자세한 내용을 볼 수 있어요.</p>
      <div class="grid cols-3">
        {products.map((p) => (
          <a class="card" href={u(`/products/${p.slug}`)}>
            <ImageBox src={p.image} alt={p.title} />
            <div class="card-body"><h3>{p.title}</h3><p>{p.summary}</p></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container">
      <h2>설비 상담이 필요하신가요?</h2>
      <p>{site.hours} · <a href={`tel:${site.tel}`}>{site.tel}</a></p>
      <a class="btn" href={u('/contact')}>문의하기</a>
    </div>
  </section>
</Layout>

<style>
  .hero { background: linear-gradient(120deg, rgba(8,58,102,.92), rgba(11,79,138,.75)), var(--hero-bg) center / cover; color: #fff; padding: 140px 0 120px; }
  .hero .eyebrow { color: rgba(255,255,255,.8); }
  .hero h1 { font-size: 2.8rem; line-height: 1.3; margin: 10px 0 16px; }
  .hero p { font-size: 1.1rem; opacity: .9; margin: 0 0 32px; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .cta { background: var(--brand); color: #fff; text-align: center; padding: 64px 0; }
  .cta h2 { margin: 0 0 8px; }
  .cta p { margin: 0 0 24px; opacity: .9; }
  .cta .btn { background: #fff; color: var(--brand); }
  @media (max-width: 720px) { .hero { padding: 96px 0 80px; } .hero h1 { font-size: 2rem; } }
</style>
