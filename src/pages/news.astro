---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import pages from '../data/pages.json';
const items = pages.news?.items ?? [];
---
<Layout title="소식">
  <PageHero eyebrow="News" title="소식" desc="회사의 새로운 소식을 전해 드립니다." />
  <section class="section">
    <div class="container">
      <ul class="list">
        {items.map((n, i) => (
          <li id={'n' + i} data-reveal>
            <details open={i === 0}>
              <summary><span class="date">{n.date}</span><strong>{n.title}</strong><span class="plus">+</span></summary>
              <p>{n.body}</p>
            </details>
          </li>
        ))}
      </ul>
      {items.length === 0 && <p class="section-desc">아직 등록된 소식이 없어요.</p>}
    </div>
  </section>
</Layout>

<style>
  .list { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--text); }
  li { border-bottom: 1px solid var(--line); }
  summary { display: flex; align-items: center; gap: 32px; padding: 24px 8px; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary:hover strong { color: var(--accent); }
  .date { color: var(--muted); min-width: 96px; font-size: .92rem; }
  strong { flex: 1; font-size: 1.08rem; }
  .plus { font-size: 1.4rem; color: var(--muted); transition: transform .25s; }
  details[open] .plus { transform: rotate(45deg); }
  p { white-space: pre-line; margin: 0; padding: 4px 8px 28px 136px; color: var(--muted); }
  @media (max-width: 720px) { summary { flex-wrap: wrap; gap: 4px 12px; } p { padding-left: 8px; } }
</style>
